# Copy this file to .env (gitignored) and fill in real values.
# Environment variables always win over the file, so CI can inject secrets.
#
# DashScope / OpenAI-compatible endpoint used by config/settings.yaml.
DASHSCOPE_API_KEY=your-api-key-here

# Only needed when running a provider whose SDK reads its own variable,
# e.g. provider: openai without an api_key in settings.yaml.
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
